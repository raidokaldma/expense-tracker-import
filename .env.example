# Copy to .env and fill in. Paths are inside the container (compose mounts ./secrets at /secrets).

# Enable Banking application: its id and private key (the .pem from the control panel)
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_KEY_FILE=/secrets/enable-banking.pem
# Where the bank sends the browser back; must be registered for the application
REDIRECT_URL=https://localhost:3000/api/import/connections/callback

# Serve HTTPS with this certificate: for local development, where the redirect is https://localhost.
# Leave empty behind a proxy that does HTTPS (e.g. a Cloudflare tunnel).
TLS_CERT_FILE=
TLS_KEY_FILE=

# Where the rows are imported, e.g. http://host.docker.internal:8080/ for expense-tracker on the same host.
# Empty: the rows are printed to the console (docker compose logs) instead.
EXPENSE_TRACKER_URL=

# Days back each fetch asks for
FETCH_DAYS=60
