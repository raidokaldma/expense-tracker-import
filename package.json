{
  "name": "expense-importer",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node server/dev.ts",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/main.ts",
